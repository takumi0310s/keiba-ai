# netkeiba Premium Cookie
# 取得手順:
# 1. ブラウザでnetkeiba にログイン（スーパープレミアム会員）
# 2. https://race.netkeiba.com/race/oikiri.html?race_id=202609010901 を開く
# 3. F12 → Network → 任意のリクエスト → Headers → Cookie の値をコピー
# 4. 以下に貼り付け（ダブルクォーテーションで囲む）
NETKEIBA_COOKIE="nkauth=XXXX; _nk_session=XXXX; ..."

# Discord Webhook URLs
# 買い目通知（レース予測）
DISCORD_WEBHOOK_BETS="https://discord.com/api/webhooks/XXXX/YYYY"
# システム通知（スクレイピング完了、結果照合等）
DISCORD_WEBHOOK_UPDATES="https://discord.com/api/webhooks/XXXX/ZZZZ"
# フォールバック（上記未設定時に使用）
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/WWWW"
